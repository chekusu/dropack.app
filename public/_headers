# No analytics and no third-party requests. "no-transform" stops Cloudflare from rewriting
# responses, including automatic Web Analytics beacon injection. The only script is the
# self-hosted language selector (/lang.js); media (film, captions) is self-hosted too.
/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Film media has content-hashed names, so it never changes in place.
/media/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform

# Captioned exports and subtitle files download instead of opening in the browser.
/media/dl/*
  Content-Disposition: attachment
